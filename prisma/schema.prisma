// Invoice application schema — Docs/product_spec.md §1, 
// Pinned to Prisma 6.x conventions — datasource url
// stays in schema.prisma via env(), not moved to prisma.config.ts's adapter pattern.

generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum PartyType {
  INDIVIDUAL
  ORGANIZATION
}

enum PaymentMethodType {
  BANK_WIRE
  ZELLE
  PAYONEER
  CUSTOM
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum AiProviderName {
  google
  anthropic
  groq
}

/// M26 — expanded from USD/AUD/GBP to add NZD/AED/
/// PKR/SAR (future-proofing per the user, no concrete need yet beyond the
/// original three). Used both for `Project.displayCurrency` (whose meaning
/// now depends on `ProjectCurrencyMode`, see below) and `Invoice.currency`.
enum DisplayCurrency {
  USD
  AUD
  GBP
  NZD
  AED
  PKR
  SAR
}

/// M26. `SINGLE` (default): `Project.displayCurrency`
/// is the whole invoice's one and only currency (may be USD — every project
/// created before this milestone is `SINGLE`+`USD`, i.e. unchanged behavior).
/// `DUAL`: today's original behavior — every core amount is USD,
/// `Project.displayCurrency` (never USD in this mode) only adds a manually
/// entered `Invoice.convertedTotal` shown alongside, never replacing, the USD
/// figures.
enum ProjectCurrencyMode {
  SINGLE
  DUAL
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

/// M19.2a — optional per-project invoice period,
/// used only to compute the create form's default due date (M19.2b). Each
/// value has fixed math: WEEKLY/SEMI_MONTHLY are flat day-adds (+7/+15),
/// MONTHLY is calendar-month arithmetic (+1 month), never a flat 30 days.
enum InvoicePeriodType {
  WEEKLY
  SEMI_MONTHLY
  MONTHLY
}

/// Docs/product_spec.md §1.1. No Role field — any party may be used as a
/// Project's contractor, client, or both (Docs/implementation_decisions.md §15).
/// Address is inlined (§16) — no separate Address entity.
model Party {
  id String @id @default(cuid())
  name String
  email String?
  type PartyType
  street1 String?
  street2 String?
  city String?
  state String?
  postalCode String?
  country String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paymentMethods PaymentMethod[]
  projectsAsContractor Project[] @relation("ContractorParty")
  projectsAsClient Project[] @relation("ClientParty")
}

/// Docs/product_spec.md §1.2. `fields` is an ordered {key,label,value}[] array —
/// see §2 for shape. Service layer enforces at most one IsDefault per party
/// (Docs/implementation_decisions.md §22) — not a DB-level constraint.
model PaymentMethod {
  id String @id @default(cuid())
  partyId String
  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)
  type PaymentMethodType
  label String
  isDefault Boolean @default(false)
  fields Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  preferredByProjects Project[] @relation("ProjectPreferredPaymentMethod")

  @@index([partyId])
}

/// Docs/product_spec.md §1.3. `abbreviation` sources the {abbreviation}
/// invoice-number placeholder, falling back to auto-derived initials of
/// `name` if left blank (Docs/implementation_decisions.md §9/§22).
/// `serviceDescription` is the invoice
/// document's "Details" text, live-joined at render time (never snapshotted
/// onto Invoice) and falling back to `name` when unset — same live-join,
/// no-lock-at-SENT behavior `name` itself had there before M23.
/// M35 — `referralCreditEnabled` gates whether the invoice form's "Add
/// Referral Credit" button is shown at all (default off); `referralCreditLabel`
/// overrides the line item's default description, falling back to
/// "Referral Credit (Thank you!)" when unset — same nullable/fallback shape
/// as `serviceDescription`, freely editable per-invoice afterward.
/// M28 — `createdByUserId` is nullable (existing rows predate auth) and
/// set once at creation only, never touched by updates; `onDelete: SetNull`
/// since this is informational, not a real ownership relationship —
/// removing a user's login access never blocks on or cascades into
/// projects they created.
model Project {
  id String @id @default(cuid())
  name String
  abbreviation String?
  serviceDescription String?
  clientId String
  client Party @relation("ClientParty", fields: [clientId], references: [id], onDelete: Restrict)
  contractorId String
  contractor Party @relation("ContractorParty", fields: [contractorId], references: [id], onDelete: Restrict)
  preferredPaymentMethodId String?
  preferredPaymentMethod PaymentMethod? @relation("ProjectPreferredPaymentMethod", fields: [preferredPaymentMethodId], references: [id], onDelete: Restrict)
  invoiceNumberFormat String
  invoicePeriodType InvoicePeriodType?
  displayCurrency DisplayCurrency @default(USD)
  currencyMode ProjectCurrencyMode @default(SINGLE)
  referralCreditEnabled Boolean @default(false)
  referralCreditLabel String?
  status ProjectStatus @default(ACTIVE)
  /// Manual global display order (Projects page cards/table, dashboard
  /// "Project billing status" table) — reordered via up/down arrows on the
  /// dashboard, swapping values with the adjacent ACTIVE project rather than
  /// a full renumber, so an ARCHIVED project sitting between two ACTIVE ones
  /// numerically never has to move. Backfilled alphabetically at migration
  /// time; new projects append to the end (current max + 1). The `@default`
  /// only matters for direct-Prisma test/seed fixtures that skip
  /// projectService.create (which always sets an explicit value) — it
  /// deliberately sorts below the backfilled positive values.
  sortOrder Int @default(0)
  createdByUserId String?
  createdBy User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]
  alertSchedules ProjectAlertSchedule[]

  @@index([clientId])
  @@index([contractorId])
  @@index([preferredPaymentMethodId])
  @@index([createdByUserId])
  @@index([sortOrder])
}

/// Docs/product_spec.md §1.6. M29 — a day-of-month reminder for a Project,
/// purely calendar-driven, in-app only (no email/push, no cron). `recurring`
/// is per-schedule, not per-project (Docs/implementation_decisions.md §24).
/// `clearedAt` is the entire "already fired" state machine: for a recurring
/// schedule, cleared-this-month hides it and cleared-in-an-earlier-month
/// re-arms it automatically; for a one-time schedule, any non-null value
/// hides it permanently. See src/lib/alertScheduleFiring.ts for the exact
/// firing logic derived from this field plus `dayOfMonth`/`recurring`.
model ProjectAlertSchedule {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dayOfMonth Int
  recurring Boolean @default(true)
  label String?
  clearedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

/// Docs/product_spec.md §1.4. Snapshot-only — no live PaymentMethodId FK
/// (Docs/implementation_decisions.md §11). Deletable in any status
/// (Docs/implementation_decisions.md §18/§22), cascading InvoiceItem rows.
/// `currency` is the currency `subtotal`/
/// `total`/every `InvoiceItem` rate is actually denominated in — always
/// `USD` for a `DUAL`-mode project's invoice, the project's `displayCurrency`
/// for a `SINGLE`-mode one. Same snapshot-timing rule as everything else:
/// recomputed from the live project on every `DRAFT` save and the final
/// `DRAFT → SENT` transition, then permanently locked.
/// M28 — `createdByUserId` is nullable, set once at creation only,
/// `onDelete: SetNull` — same reasoning as `Project.createdByUserId` above.
model Invoice {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  invoiceNumber String
  status InvoiceStatus @default(DRAFT)
  issueDate DateTime @db.Date
  dueDate DateTime @db.Date
  /// M39 — the billing period this invoice covers (distinct from
  /// issueDate/dueDate, which are about payment timing, not the work
  /// period). Both nullable/independent: not every invoice is period-based
  /// (a flat one-off fee has none), and there's no DB-level ordering
  /// constraint between them, only app-level validation.
  periodStart DateTime? @db.Date
  periodEnd DateTime? @db.Date
  subtotal Decimal @db.Decimal(12, 2)
  total Decimal @db.Decimal(12, 2)
  currency DisplayCurrency @default(USD)
  convertedTotal Decimal? @db.Decimal(12, 2)
  convertedCurrency String?
  fromPartySnapshot Json
  toPartySnapshot Json
  paymentDetailsSnapshot Json
  itemsNote String?
  bottomNote String?
  createdByUserId String?
  createdBy User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items InvoiceItem[]

  @@unique([projectId, invoiceNumber])
  @@index([status])
  @@index([dueDate])
  @@index([createdByUserId])
}

/// Docs/product_spec.md §1.5. `sortOrder` preserves line-item display order
/// (Docs/implementation_decisions.md §22) — Postgres rows have no inherent order.
/// `isFlatAmount` (M14) toggles per-row between Hourly (quantity/unitPrice
/// required, `amount` backend-computed) and Flat (`amount` entered directly,
/// quantity/unitPrice null) — see Docs/implementation_decisions.md §10.
/// `isReferralCredit` (M35) marks at most one row per invoice (app-enforced,
/// not a DB constraint — see invoiceService.ts) as a referral-credit
/// deduction: it implies the same null-quantity/unitPrice shape as
/// `isFlatAmount` (also set true alongside it), plus a negative `amount` —
/// the user only ever types a positive magnitude, negated server-side
/// before storage. Always rendered last regardless of `sortOrder`
/// (documentService.ts).
/// `durationText` (M48) is a free-text label shown in place of the
/// Unit(Hrs)/Rate columns for a Flat-amount row (e.g. "Fixed", "50%", "2
/// weeks") — set only when `isFlatAmount` is true and `isReferralCredit` is
/// false; null for Hourly rows and for the referral-credit row. The whole
/// invoice's line-items table only switches to the single-Duration-column
/// layout when every item on it is Flat-amount (documentService.ts) — a
/// mixed invoice keeps the Unit(Hrs)/Rate columns as before.
model InvoiceItem {
  id String @id @default(cuid())
  invoiceId String
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  isFlatAmount Boolean @default(false)
  isReferralCredit Boolean @default(false)
  quantity Decimal? @db.Decimal(10, 2)
  unitPrice Decimal? @db.Decimal(12, 2)
  amount Decimal @db.Decimal(12, 2)
  durationText String?
  sortOrder Int

  @@index([invoiceId])
}

/// M28. `ADMIN`: everything, including `/settings`. `STANDARD`: everything
/// except `/settings`. `RESTRICTED`: full Invoice access, but blocked from
/// creating/editing/deleting Project/Party/PaymentMethod and from
/// `/settings` — see requireRole() call sites. Defaults to the most
/// restrictive value so a row created without an explicit role (shouldn't
/// normally happen — the admin always sets it explicitly) errs safe.
enum Role {
  ADMIN
  STANDARD
  RESTRICTED
}

/// M28. Google-OAuth-only, no self-registration — a sign-in only succeeds
/// if a row already exists for that email (src/lib/auth.ts's `signIn`
/// callback). `name`/`image` are synced from the Google profile on every
/// login, not locked at creation. Auth.js's Prisma adapter owns this model
/// alongside Account/Session/VerificationToken below.
model User {
  id String @id @default(cuid())
  name String?
  email String @unique
  emailVerified DateTime?
  image String?
  role Role @default(RESTRICTED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]
  createdInvoices Invoice[]
  createdProjects Project[]
}

/// M28 — Auth.js Prisma adapter's standard shape (one row per linked OAuth
/// provider account; only Google is used here). Do not hand-edit this
/// model's fields — they must match what @auth/prisma-adapter expects.
model Account {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  type String
  provider String
  providerAccountId String
  refresh_token String? @db.Text
  access_token String? @db.Text
  expires_at Int?
  token_type String?
  scope String?
  id_token String? @db.Text
  session_state String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// M28 — database session strategy, chosen specifically so removing/
/// demoting a User takes effect immediately (deleting this row) rather
/// than waiting out a token's expiry, unlike JWT sessions.
/// `onDelete: Cascade` from User is what makes revocation immediate.
model Session {
  id String @id @default(cuid())
  sessionToken String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires DateTime

  @@index([userId])
}

/// M28 — part of Auth.js's standard adapter shape; not actually exercised
/// by the Google-OAuth-only flow used in this app (no email/magic-link
/// sign-in), kept for adapter schema compliance.
model VerificationToken {
  identifier String
  token String
  expires DateTime

  @@unique([identifier, token])
}

/// M16 — DB-backed AI-assist provider config,
/// replacing M11's environment-variables-only decision. Exactly one row per
/// fixed provider (google/anthropic/groq — never a dynamic/admin-defined
/// provider list, see the M16 note). `apiKeyCiphertext` is AES-256-GCM
/// (encrypted with `SETTINGS_ENCRYPTION_KEY`), never stored/returned as
/// plaintext. `models` is an ordered free-text list — array position IS the
/// within-provider fallback order, same convention as `PaymentMethod.fields`.
/// `order` is the cross-provider cascade order (0 = default/first-tried).
model AiProviderSetting {
  provider AiProviderName @id
  apiKeyCiphertext String?
  models String[] @default([])
  enabled Boolean @default(true)
  order Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
